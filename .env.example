# ──────────────────────────────────────────────────────────
# INDRA-MARKETMIND — Environment Variables
# Copy this file to .env and fill in your actual keys
# ──────────────────────────────────────────────────────────

# ── API KEYS ──────────────────────────────────────────────
# Get from: https://newsapi.org/
NEWSAPI_KEY=your_newsapi_key_here

# Get from: https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# Get from: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=IndraMarketMindBot/1.0

# Get from: Telegram BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# ── V3.0 HEDGE FUND EDITION APIS ─────────────────────────
# Get from: console.groq.com (For RAG Chatbot Phase 9)
GROQ_API_KEY=your_groq_api_key_here

# Get from: alpaca.markets (For Auto-Execution Phase 10)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# Get from: alchemy.com (For Crypto Whale Tracker Phase 12)
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Get from: aviationstack.com (For Alt Data Phase 13)
AVIATIONSTACK_API_KEY=your_aviationstack_key_here
# ──────────────────────────────────────────────────────────

# ── DATABASE SECRETS ──────────────────────────────────────
POSTGRES_USER=indra_admin
POSTGRES_PASSWORD=super_secret_password_here
POSTGRES_DB=marketmind_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ── SYSTEM CONFIG ─────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=generate_a_random_secret_string_here
