# ──────────────────────────────────────────────────────────
# INDRA-MARKETMIND — Environment Variables Template
# Copy this file to .env and fill in your actual keys.
# All services feature built-in zero-config offline fallbacks.
# ──────────────────────────────────────────────────────────

# ── SYSTEM & ENVIRONMENT ───────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=indra_marketmind_default_secret_key_2026

# ── DATABASE & CACHE ──────────────────────────────────────
POSTGRES_USER=indra
POSTGRES_PASSWORD=marketmind
POSTGRES_DB=marketmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://indra:marketmind@postgres:5432/marketmind

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── PHASE 1-8: MARKET DATA & ALERTS ───────────────────────
NEWSAPI_KEY=your_newsapi_key_here
FINNHUB_API_KEY=your_finnhub_key_here
ALPHA_VANTAGE_KEY=your_alphavantage_key_here
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=IndraMarketMindBot/1.0
SEC_EDGAR_USER_AGENT=IndraMarketMind indrajitkumar23541@gmail.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── PHASE 9: LLM RAG CHATBOT ──────────────────────────────
# Optional: Groq (fastest) or OpenAI. Falls back to offline financial analyst if unset.
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── PHASE 10: AUTO-EXECUTION & PAPER TRADING ───────────────
# Options: paper (default), ibkr, zerodha, alpaca, signal_only
ACTIVE_BROKER=paper
AUTO_EXECUTE=false
MAX_RISK_PER_TRADE=0.02
MAX_DRAWDOWN_LIMIT=0.15
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
IBKR_ACCOUNT_ID=
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── PHASE 11: MULTI-MODAL AI AUDIO SENTIMENT ──────────────
# Uses Groq Whisper or OpenAI Whisper if provided; realistic transcript fallback if unset.
SENTIMENT_SERVICE_URL=http://sentiment-service:8002/analyze

# ── PHASE 12: CRYPTO ON-CHAIN METRICS ─────────────────────
ALCHEMY_API_KEY=

# ── PHASE 13: ALTERNATIVE DATA & GOOGLE TRENDS ────────────
AVIATIONSTACK_API_KEY=

# ── PHASE 14: KUBERNETES & CLOUD ORCHESTRATION ────────────
K8S_NAMESPACE=marketmind
